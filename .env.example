# Copy to .env.local (and set in your host's env vars for production)

# Canonical production URL — used by sitemap.xml, robots.txt, canonical tags
# and OpenGraph URLs. Must NOT have a trailing slash.
NEXT_PUBLIC_SITE_URL=https://tadecoffee.com

# Google Search Console verification (meta-tag method).
# Value is the content="" of the <meta name="google-site-verification"> tag.
# ⚠️ Paste ONLY the token, NOT the whole <meta ... /> HTML snippet.
# Correct:   GOOGLE_SITE_VERIFICATION=z7XbjeCN-JMYYp4...
# Incorrect: GOOGLE_SITE_VERIFICATION=<meta name="google-site-verification" ... />
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification.
# Value is the content="" of the <meta name="msvalidate.01"> tag.
BING_SITE_VERIFICATION=

# IndexNow key — must match the file at public/<key>.txt.
# Only needed if you rotate the key; the default is already wired up.
INDEXNOW_KEY=a63bac60851f6dc504d21102c01cf17e
